# Database
DATABASE_URL=postgresql://llmio:llmio_password@db:5432/llmio
DB_ECHO=False

# JWT Authentication
SECRET_KEY=##GENERATE AND UPDATE IT from secrets.token_hex(32)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application
APP_NAME=LLM.io
DEBUG=False
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost,http://localhost:80

# API Keys Encryption
ENCRYPTION_KEY=##GENERATE AND UPDATE IT from Fernet

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Streaming
STREAM_TIMEOUT=300
HEARTBEAT_INTERVAL=15
MAX_RECONNECT_ATTEMPTS=5
BUFFER_SIZE=1000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
